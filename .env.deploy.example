# ─────────────────────────────────────────────────────────────────────────────
#  PRODUCTION DEPLOY CONFIG — gitignored (.gitignore rule `.env.*`). Do not commit.
#  This file is NOT read by the app and NOT baked into the image. It is read only
#  by scripts/deploy-prod.sh, which turns the four *_API_KEY values into Secret
#  Manager secrets and the rest into Cloud Run env vars.
#
#  Fill every __FILL_*__ placeholder, then run:
#      ./scripts/deploy-prod.sh --dry-run    # shows the plan, touches nothing
#      ./scripts/deploy-prod.sh              # applies it
#
#  Keys are never passed on a command line and never printed. See the script.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode ─────────────────────────────────────────────────────────────────────
# false turns on live mode. It does NOT break the demo path: a mode:"demo"
# request bypasses the access gate entirely and still serves seed data.
DEMO_MODE=false

# The shared secret printed in the pitch deck. Comma-separated if you are
# rotating and want the old key to keep working. Must not contain a comma.
AGENT_ACCESS_KEYS=__FILL_PITCH_ACCESS_KEY__

# ── Provider pool ────────────────────────────────────────────────────────────
# Order is a cost decision: provider 1 serves every request, and 2/3 only run
# when 1 rate-limits, runs out of quota, times out or 5xxs. Free tiers lead.

# Slot 1 — Google AI Studio (Gemini). Most generous free tier.
LLM_PROVIDER_1_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_PROVIDER_1_MODEL=gemini-2.5-flash
LLM_PROVIDER_1_API_KEY=__FILL_GEMINI_KEY__

# Slot 2 — Mistral. Small free-tier allowance; only reached when slot 1 is out.
LLM_PROVIDER_2_BASE_URL=https://api.mistral.ai/v1
LLM_PROVIDER_2_MODEL=mistral-small-latest
LLM_PROVIDER_2_API_KEY=__FILL_MISTRAL_KEY__

# Slot 3 — OpenCode Console. THIS ONE BILLS (pay-as-you-go, auto-reload).
# Keep it last. Only models ending `-free` cost nothing.
# Do NOT use `beam-free` — it is not served in Hong Kong.
LLM_PROVIDER_3_BASE_URL=https://opencode.ai/zen/v1
LLM_PROVIDER_3_MODEL=deepseek-v4.1-flash-free
LLM_PROVIDER_3_API_KEY=__FILL_OPENCODE_KEY__

LLM_POOL_SIZE=3
LLM_POOL_FAILOVER_ENABLED=true

# ── Search ───────────────────────────────────────────────────────────────────
TAVILY_API_KEY=__FILL_TAVILY_KEY__

# ── Where it goes ────────────────────────────────────────────────────────────
HONGXPLORE_PROJECT=hongxplore
HONGXPLORE_SERVICE=hongxplore
HONGXPLORE_REGION=asia-east2
