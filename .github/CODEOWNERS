# Zone owners — enforced by the zone-guard CI job (§8.2), not by a GitHub checkbox.
# PARSER CONSTRAINT: zone_guard.py supports ONLY '*', '/dir/' and '/file' patterns
# (no globs like '*.md'), and always reads this file from the PR's BASE commit.
* @zsuryk

/api/              @zsuryk       # routes/models/config/tests (api zone)
/api/app/services/ @kORNkin      # services zone (last match wins)
/api/app/prompts/  @kORNkin      # prompts zone (last match wins)
/api/tests/prompts/ @kORNkin     # cross-zone tests for the prompts zone
/api/tests/services/ @kORNkin    # cross-zone tests for the services zone
/web/              @sweetpinejam
/data/             @kORNkin
/docs/             @zsuryk

# Governance paths — repo-admin only: changes here need the admin's zone-guard approval
/.github/     @zsuryk       # workflows (the CI flow), CODEOWNERS itself, templates
/.gitignore   @zsuryk       # secret-exclusion guard — un-ignoring .env would leak secrets
/AGENTS.md    @zsuryk       # rules every teammate's agent follows
/GEMINI.md    @zsuryk
/docs/agents/ @zsuryk       # issue-tracker / triage-labels / domain config
