# Hongxplore API — copy to .env (never commit .env)
# cp .env.example .env

# --- LLM (any OpenAI-compatible endpoint — see ADR-0002) ------------------
# API key for the OpenAI-compatible endpoint. Optional while DEMO_MODE=true.
OPENAI_API_KEY=
# Optional base URL override for non-OpenAI providers (Ollama, vLLM, OpenRouter, ...).
OPENAI_BASE_URL=
# Model name — each dev sets their own. This repo implies no default model.
OPENAI_MODEL=

# --- Search ---------------------------------------------------------------
# Tavily search API key. Required for live search; unused while DEMO_MODE=true.
TAVILY_API_KEY=

# --- Demo resilience ------------------------------------------------------
# true = serve bundled seed JSON, zero network calls. Keep true for demos & CI.
# Strict boolean: true/false, yes/no, 1/0, on/off — an unparseable value
# (e.g. "yes-ish") aborts API startup with a pointer back to this file.
DEMO_MODE=true
