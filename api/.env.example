# Hongxplore API — copy to .env (never commit .env)
# cp .env.example .env

# --- LLM (any OpenAI-compatible endpoint — see ADR-0002) ------------------
# API key for the OpenAI-compatible endpoint. Optional while DEMO_MODE=true.
OPENAI_API_KEY=
# Optional base URL override for non-OpenAI providers (Ollama, vLLM, OpenRouter, ...).
OPENAI_BASE_URL=
# Model name — each dev sets their own. This repo implies no default model.
OPENAI_MODEL=
# Request timeout (seconds) and retry count for the LLM client.
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_RETRIES=2

# --- LLM provider pool -----------------------------------------------------
# Every free endpoint has its own per-day cap, so the agent fails over between
# them instead of dying when one quota does (issue #84). Providers are ordered
# by the number below — nothing in the code names a vendor (ADR-0002).
#
# How many providers the agent may draw from. Providers numbered above this are
# ignored, so you can keep a spare configured without ever rotating to it.
LLM_POOL_SIZE=1
# Rotate to the next provider when one rate-limits, runs out of quota, times out
# or errors. A no-op while LLM_POOL_SIZE=1.
LLM_POOL_FAILOVER_ENABLED=true
# Per-request timeout and retry budget for the pool.
LLM_POOL_TIMEOUT_SECONDS=30.0
LLM_POOL_MAX_RETRIES=2
# One triplet per provider, in failover order. Copy the block and renumber it
# to add another. While no triplet is set, provider 1 falls back to the
# OPENAI_* keys above, so existing setups keep working.
#
# MODEL takes a comma-separated list, in failover order *within* that provider:
# every model of provider 1 is tried, in the order written, before the pool
# moves on to provider 2. A single value behaves exactly as it always did.
#
#   LLM_PROVIDER_1_MODEL=gemini-2.5-flash                       # one model
#   LLM_PROVIDER_1_MODEL=gemini-2.5-flash,gemini-2.0-flash      # a spare behind it
#
# A listed spare is cheap insurance against the two ways one model dies
# mid-demo: its own per-model quota runs out, or the id 404s because the
# provider does not serve that model in this region — OpenCode Console's
# `beam-free` is a live example from Hong Kong.
# LLM_PROVIDER_1_BASE_URL=
# LLM_PROVIDER_1_MODEL=
# LLM_PROVIDER_1_API_KEY=

# --- Search ---------------------------------------------------------------
# Tavily search API key. Required for live search; unused while DEMO_MODE=true.
TAVILY_API_KEY=
# How long a cached query result stays fresh (seconds). 86400 = one day.
TAVILY_CACHE_TTL_SECONDS=86400
# Per-request timeout for the search client (seconds).
TAVILY_TIMEOUT_SECONDS=15.0
# Hard ceiling on results fetched from one query.
TAVILY_MAX_RESULTS=10
# How many results to pull from the curated high-trust HK domains before
# falling back to open web search.
TAVILY_MIN_CURATED_RESULTS=3
# Extract structured activities from snippets with the LLM. Off by default —
# it costs tokens on every uncached query and the deterministic extractor is
# the fallback either way.
TAVILY_EXTRACT_WITH_LLM=false
# Where the SQLite query cache lives. Blank means the service default; the
# local cache directory (api/.cache/) is gitignored so it is never committed.
SEARCH_CACHE_PATH=

# --- Retrieval ------------------------------------------------------------
# How many activity cards one query may return. Higher fills the board and
# shows off auto-fit; it should not bury the user. Bounded 3–10.
AGENT_MATCH_LIMIT=6

# --- Demo resilience ------------------------------------------------------
# true = serve bundled seed JSON, zero network calls. Keep true for demos & CI.
# Strict boolean: true/false, yes/no, 1/0, on/off — an unparseable value
# (e.g. "yes-ish") aborts API startup with a pointer back to this file.
DEMO_MODE=true

# --- Pitch access gate ------------------------------------------------------
# Valid agent access keys, comma-separated. This is the shared secret printed in
# the pitch deck that judges paste into the browser to unlock LIVE mode — it is
# NOT an LLM or search provider key, and no provider key ever belongs here.
#
# Several, so the pitch key can be rotated by editing this one line: no code
# change, no web redeploy. A key can stay listed while its replacement is being
# handed out, then be dropped once nobody is using it.
#
# Blank means no key is valid, so live mode is refused outright — the gate fails
# closed. While DEMO_MODE=true every key here is ignored anyway: a demo-only
# instance refuses live requests regardless of the key.
AGENT_ACCESS_KEYS=

# --- Public surface (issue #88) -----------------------------------------------
# The deployed URL is unauthenticated and spends provider quota, so the limits
# that guard it are configuration rather than code. Defaults are sized for a
# demo: a judge's session is a few dozen queries and never reaches them, while a
# bored stranger runs into them inside a minute. Tighten them for pitch day
# without a code change or a redeploy.

# Requests one client may make to POST /api/agent per window. 60/minute is far
# above a demo and far below a script. Set false to switch the limit off for a
# local soak test — never on the deployment.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60.0
# Charge the leftmost X-Forwarded-For entry rather than the socket peer. Cloud Run
# puts the caller's address there and the socket belongs to the proxy, so without
# this every visitor shares one bucket and one judge's session could lock out the
# room. The header is caller-controlled: this is a cost cap and a courtesy, not
# authentication. Set false only behind a proxy you control that rewrites it.
RATE_LIMIT_TRUST_FORWARDED_FOR=true
# Largest request body accepted, in bytes. Checked against Content-Length before
# the body is read, so an oversized request costs a header parse and nothing
# else. Floor 1024 — below that a real request could not be sent anyway.
MAX_REQUEST_BYTES=16384
# Ceilings on what one request may ask for. Both are money caps: the query becomes
# prompt tokens upstream, and every free slot is a filter the search must satisfy.
# A request over either is refused before any provider is called.
AGENT_MAX_QUERY_CHARS=500
AGENT_MAX_FREE_SLOTS=12

# Cross-origin allowlist, comma-separated, explicit origins only. A wildcard is
# refused at startup, so a typo cannot widen the door: it would let any page on
# the internet drive this deployment.
#
# Blank means "allow nothing", which is the right setting for the single public
# URL of ADR-0006 — the web app and the API share an origin there, so there is no
# cross-origin request to allow. Set the Vite dev origin for local development,
# and add an origin only if you deliberately serve the client from somewhere else.
# Credentials are never enabled; nothing here uses a cookie.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# How long a browser may cache a successful preflight (seconds).
CORS_PREFLIGHT_MAX_AGE_SECONDS=600

