# Hongxplore API — copy to .env (never commit .env)
# cp .env.example .env

# --- LLM (any OpenAI-compatible endpoint — see ADR-0002) ------------------
# API key for the OpenAI-compatible endpoint. Optional while DEMO_MODE=true.
OPENAI_API_KEY=
# Optional base URL override for non-OpenAI providers (Ollama, vLLM, OpenRouter, ...).
OPENAI_BASE_URL=
# Model name — each dev sets their own. This repo implies no default model.
OPENAI_MODEL=
# Request timeout (seconds) and retry count for the LLM client.
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_RETRIES=2

# --- LLM provider pool -----------------------------------------------------
# Every free endpoint has its own per-day cap, so the agent fails over between
# them instead of dying when one quota does (issue #84). Providers are ordered
# by the number below — nothing in the code names a vendor (ADR-0002).
#
# How many providers the agent may draw from. Providers numbered above this are
# ignored, so you can keep a spare configured without ever rotating to it.
LLM_POOL_SIZE=1
# Rotate to the next provider when one rate-limits, runs out of quota, times out
# or errors. A no-op while LLM_POOL_SIZE=1.
LLM_POOL_FAILOVER_ENABLED=true
# Per-request timeout and retry budget for the pool.
LLM_POOL_TIMEOUT_SECONDS=30.0
LLM_POOL_MAX_RETRIES=2
# One triplet per provider, in failover order. Copy the block and renumber it
# to add another. While no triplet is set, provider 1 falls back to the
# OPENAI_* keys above, so existing setups keep working.
# LLM_PROVIDER_1_BASE_URL=
# LLM_PROVIDER_1_MODEL=
# LLM_PROVIDER_1_API_KEY=

# --- Search ---------------------------------------------------------------
# Tavily search API key. Required for live search; unused while DEMO_MODE=true.
TAVILY_API_KEY=
# How long a cached query result stays fresh (seconds). 86400 = one day.
TAVILY_CACHE_TTL_SECONDS=86400
# Per-request timeout for the search client (seconds).
TAVILY_TIMEOUT_SECONDS=15.0
# Hard ceiling on results fetched from one query.
TAVILY_MAX_RESULTS=10
# How many results to pull from the curated high-trust HK domains before
# falling back to open web search.
TAVILY_MIN_CURATED_RESULTS=3
# Extract structured activities from snippets with the LLM. Off by default —
# it costs tokens on every uncached query and the deterministic extractor is
# the fallback either way.
TAVILY_EXTRACT_WITH_LLM=false
# Where the SQLite query cache lives. Blank means the service default; the
# local cache directory (api/.cache/) is gitignored so it is never committed.
SEARCH_CACHE_PATH=

# --- Retrieval ------------------------------------------------------------
# How many activity cards one query may return. Higher fills the board and
# shows off auto-fit; it should not bury the user. Bounded 3–10.
AGENT_MATCH_LIMIT=6

# --- Demo resilience ------------------------------------------------------
# true = serve bundled seed JSON, zero network calls. Keep true for demos & CI.
# Strict boolean: true/false, yes/no, 1/0, on/off — an unparseable value
# (e.g. "yes-ish") aborts API startup with a pointer back to this file.
DEMO_MODE=true

# --- Pitch access gate ------------------------------------------------------
# Valid agent access keys, comma-separated. This is the shared secret printed in
# the pitch deck that judges paste into the browser to unlock LIVE mode — it is
# NOT an LLM or search provider key, and no provider key ever belongs here.
#
# Several, so the pitch key can be rotated by editing this one line: no code
# change, no web redeploy. A key can stay listed while its replacement is being
# handed out, then be dropped once nobody is using it.
#
# Blank means no key is valid, so live mode is refused outright — the gate fails
# closed. While DEMO_MODE=true every key here is ignored anyway: a demo-only
# instance refuses live requests regardless of the key.
AGENT_ACCESS_KEYS=

